#!/usr/bin/dh-exec

# The binary, udev rule, icon, desktop file and appstream metainfo are all
# installed straight into debian/tmp by CMake's own install() rules (see
# src/linux/PlatformPackaging.cmake), so just claim them by destination path
# rather than re-sourcing them from the tree -- doing both leaves the
# CMake-installed copy in debian/tmp unclaimed and dh_missing aborts the build.
usr/bin/rpi-imager
usr/lib/udev/rules.d/99-rpiboot.rules
usr/share/icons/hicolor/scalable/apps/rpi-imager.svg
usr/share/applications/com.raspberrypi.rpi-imager.desktop
usr/share/metainfo/com.raspberrypi.rpi-imager.metainfo.xml

# Not installed by CMake; source directly.
debian/com.raspberrypi.rpi-imager.policy /usr/share/polkit-1/actions/
debian/com.raspberrypi.rpi-imager-manifest.xml /usr/share/mime/packages/
